-- To provide sales data to determine if a line of products should remain in stores and online or if the merchansising team
-- can pull the product from the stores and keep them online only. 


-- By Product by Channel
-- This provides a breakdown of sales based on the channel, allowing the individual retail locations to be group together under one Retail tag.

SELECT CombinedChannel
	  ,[ProductID]
      ,[Description]
      ,SUM([Quantity]) AS 'YTDQuantitySold'
      ,SUM([Revenue]) AS 'YTDRevenue'
  FROM (SELECT *
    -- because Channel breaks retail locations down into a smaller granulairty, a case statement is used to pull the Retail group from SourceCode instead
	,CASE
		WHEN [Channel]='EVENTS' THEN 'EVENTS'
		WHEN [SourceCode]='RETAIL' THEN 'RETAIL'
		WHEN [Channel]='PHONE' THEN 'PHONE'
		WHEN [Channel]='WEB' THEN 'WEB'
		ELSE ''
	END AS 'CombinedChannel'
	FROM [SupplyChain].[dbo].[AllChannelProductSales]
	WHERE [Date] >= DATEADD(day, -365, GETDATE())
	) AS Sales
  WHERE [ProductID] IN ('1000029', '1000022', '1000027', '1000037', '1000056', '1000072', '1000120', '1000234', '1000372', '1000504', '1000632', '1006023', '1003791', '1005577')
  GROUP BY [ProductID], [Description], CombinedChannel
  ORDER BY CombinedChannel, [ProductID]
;


-- Net Revenue By Product
-- This provides a high level summary of sales to decide if the products should continue being sold or if discontinuing is a better option. 

SELECT [ProductID]
      ,[Description]
      ,SUM([Quantity]) AS 'YTDQuantitySold'
      ,SUM([Revenue]) AS 'YTDRevenue'
      ,SUM([Cost]) AS 'YTDCost'
	  ,SUM([Revenue]) - SUM([Cost]) AS 'YTDNetRev'
  FROM [SupplyChain].[dbo].[AllChannelProductSales]
  WHERE [ProductID] IN ('1000029', '1000022', '1000027', '1000037', '1000056', '1000072', '1000120', '1000234', '1000372', '1000504', '1000632', '1006023', '1003791', '1005577')
	AND [Date] >= DATEADD(day, -365, GETDATE())
  GROUP BY [ProductID], [Description]
  ORDER BY [ProductID]
;
